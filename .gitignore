# Build outputs and caches (re-derivable; nothing important lives here)
/build/
/Build/
/Conf/
/out/
/.cache/
/refer/
/.local*/
/Mu_Basecore/

# Local development files
*.log
*.terminal
*.swp
*.swo
*~
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc
*.dSYM/

# Inputs, images and products that never belong in Git
*.ipsw
*.dmg
*.im4p
*.img
*.dbr
*.macho
*.o
*.a
*.dylib
*.efi
*.dtb
*.bc
*.spv
*.metallib
*.bin
# The stock /filesystems fstab subtree the ADT carries (scripts/make-adt-fstab.py regenerates
# it from the pinned DeviceTree); it has to ship with a clean checkout.
!scripts/adt-filesystems.bin
*.mbn
*.fw
*.pem
*.key
.env
local.toml

# The build tag is per-build state: scripts/build-tag.py regenerates it. Committing a stale copy
# would put yesterday's tag on today's panel, which is the exact failure this file exists to stop.
# BUILD-TAGS.tsv is the opposite: it is the log, so it stays tracked.
BUILD-TAG
drivers/MuyuDebug/build_tag_generated.h
