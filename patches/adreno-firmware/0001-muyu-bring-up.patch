index 0496c6f..5a4b0e6 100644
--- a/AdrenoHfiStartup.h
+++ b/AdrenoHfiStartup.h
@@ -16,10 +16,19 @@ typedef struct {
     uint32_t ddr_addresses[8],ddr_data[16][8];
     uint32_t acd_version,acd_enable_mask,acd_stride,acd_count,acd_data[32];
     unsigned enable_ifpc;
+    /* Gen7 firmware >= 0x20060001 answers the performance table only as message 0x0f with its
+     * own header layout: [1]=1, [2]=gpu_count, [3]=3, then 3 words/GPU level, then a gap,
+     * gmu_count, 2, and 2 words/GMU level. The legacy 0x04 table is ignored by that firmware,
+     * so a board whose GPU never leaves the slumber state must set this. */
+    unsigned perf_table_v2;
 } AdrenoHfiStartupConfig;
 typedef enum {
     AdrenoHfiStageNone,AdrenoHfiStagePerformance,AdrenoHfiStageBandwidth,
     AdrenoHfiStageAcdEnable,AdrenoHfiStageAcdTable,AdrenoHfiStageIfpc,
+    /* The gen7 firmware is also told three feature values (msg 0x0d) between the ACD table and
+     * the core start; without them it keeps the GPU core slumbered. Values are the ones the
+     * vendor driver was observed sending (kprobe capture, A735). */
+    AdrenoHfiStageSetValue0,AdrenoHfiStageSetValue1,AdrenoHfiStageSetValue2,
     AdrenoHfiStageCoreStart,AdrenoHfiStageStart,AdrenoHfiStageComplete
 } AdrenoHfiStartupStage;
