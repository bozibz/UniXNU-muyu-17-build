diff --git a/bsd/dev/arm/muyu_debug.c b/bsd/dev/arm/muyu_debug.c
new file mode 100644
index 0000000..c915165
--- /dev/null
+++ b/bsd/dev/arm/muyu_debug.c
@@ -0,0 +1,69 @@
+/*
+ * muyu: console mirror for the panel readout (u128; the USB debug port it was written for was
+ * removed 2026-11-08 - docs/ABANDONED-CHANNELS.md).
+ * Ported from ios-vermeer-lab/xnu/vermeer/vermeer_debug.c with the GUI sampler removed.
+ *
+ * Every console consumer (BSD printf via _cnputs, PE kprintf via serial_putc_crlf, and the
+ * deferred console ring's flush) appends here, in whatever context it happens to be.  The
+ * acquisition is an atomic compare-and-swap: if somebody already holds the mirror, the text is
+ * counted as dropped and thrown away.  Nothing in this file waits, allocates or writes storage,
+ * so it cannot contribute to the console deadlock it exists to observe.
+ */
+#include <sys/types.h>
+#include <sys/systm.h>
+#include <machine/atomic.h>
+
+#include "muyu_log_ring.h"
+
+static struct ml_ring log_ring;
+static uint32_t _Atomic log_lock;
+static uint64_t _Atomic dropped;
+
+void muyu_debug_append(const char *data, int size);
+unsigned muyu_debug_copy(uint64_t *pos, char *out, unsigned max);
+uint64_t muyu_debug_total(void);
+uint64_t muyu_debug_dropped(void);
+
+void
+muyu_debug_append(const char *data, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	if (!os_atomic_cmpxchg(&log_lock, 0, 1, acquire)) {
+		os_atomic_add(&dropped, (uint64_t)size, relaxed);
+		return;
+	}
+	ml_append(&log_ring, data, (unsigned)size);
+	os_atomic_store(&log_lock, 0, release);
+}
+
+unsigned
+muyu_debug_copy(uint64_t *pos, char *out, unsigned max)
+{
+	if (!os_atomic_cmpxchg(&log_lock, 0, 1, acquire)) {
+		return 0;
+	}
+	unsigned n = ml_copy(&log_ring, pos, out, max);
+
+	os_atomic_store(&log_lock, 0, release);
+	return n;
+}
+
+uint64_t
+muyu_debug_total(void)
+{
+	if (!os_atomic_cmpxchg(&log_lock, 0, 1, acquire)) {
+		return 0;
+	}
+	uint64_t n = log_ring.total;
+
+	os_atomic_store(&log_lock, 0, release);
+	return n;
+}
+
+uint64_t
+muyu_debug_dropped(void)
+{
+	return os_atomic_load(&dropped, relaxed);
+}
diff --git a/bsd/dev/arm/muyu_log_ring.h b/bsd/dev/arm/muyu_log_ring.h
new file mode 100644
index 0000000..70a86d6
--- /dev/null
+++ b/bsd/dev/arm/muyu_log_ring.h
@@ -0,0 +1,63 @@
+/*
+ * muyu: lock-free-ish console ring shared by the console paths and the panel readout.
+ * Ported from ios-vermeer-lab/xnu/vermeer/vermeer_log_ring.h (u128).
+ *
+ * The caller supplies a non-blocking acquisition; nothing here allocates, waits or touches
+ * storage.  One MiB of the tail is what the host eventually reads back.
+ */
+#ifndef MUYU_LOG_RING_H
+#define MUYU_LOG_RING_H
+
+#include <sys/types.h>
+
+#ifndef ML_RING_SIZE
+/*
+ * u128: 1 MiB (vermeer's size) does not fit this port's prelink layout - a static array that big
+ * pushes __DATA over its retained segment and emit_prelink refuses to emit the image.  128 KiB is
+ * ~1200 console lines, which is more than a panel photo ever gave us.
+ */
+#define ML_RING_SIZE (128u << 10)
+#endif
+
+struct ml_ring {
+	uint64_t total;
+	char bytes[ML_RING_SIZE];
+};
+
+static inline void
+ml_append(struct ml_ring *r, const char *s, unsigned n)
+{
+	uint64_t at = r->total;
+
+	r->total += n;
+	if (n > ML_RING_SIZE) {
+		unsigned skip = n - ML_RING_SIZE;
+		s += skip;
+		at += skip;
+		n = ML_RING_SIZE;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		r->bytes[(at + i) % ML_RING_SIZE] = s[i];
+	}
+}
+
+static inline unsigned
+ml_copy(const struct ml_ring *r, uint64_t *pos, char *out, unsigned max)
+{
+	if (*pos > r->total) {
+		*pos = 0;
+	}
+	if (r->total - *pos > ML_RING_SIZE) {
+		*pos = r->total - ML_RING_SIZE;
+	}
+	uint64_t left = r->total - *pos;
+	unsigned n = left < max ? (unsigned)left : max;
+
+	for (unsigned i = 0; i < n; i++) {
+		out[i] = r->bytes[(*pos + i) % ML_RING_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
+#endif /* MUYU_LOG_RING_H */
