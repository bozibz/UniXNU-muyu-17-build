 			gc_putchar(c);
@@ -1250,6 +1291,505 @@ vcputc(char c)
 	vcputc_options(c, false);
 }
 
+/*
+ * u125: a liveness readout that does not go through the console at all.
+ *
+ * Every heartbeat tick paints one more white block along the bottom edge of the
+ * framebuffer, straight into vinfo.v_baseaddr.  It takes no console lock, it
+ * ignores disableConsoleOutput/console_suspended, and it never writes text.  So
+ * if the block bar keeps growing the kernel is alive and only the console is
+ * stuck; if it stops the CPU itself is gone.
+ *
+ * u127: the bottom-edge copy never showed up in the u125/u126 photos, and the
+ * two explanations (heartbeat dead / v_height larger than the visible panel)
+ * call for different fixes.  So draw a second copy down the right edge as well,
+ * starting at half the nominal height: whichever one lands on the panel settles
+ * the question.  Both are painted before anything is printed, and neither can
+ * block.
+ *
+ * Only the 32bpp layout is handled (which is what this panel has); anything else
+ * is a no-op.
+ */
+static void
+muyu_vc_block(unsigned long base, unsigned int x0, unsigned int y0,
+    unsigned int w, unsigned int h)
+{
+	if (x0 >= vinfo.v_width || y0 >= vinfo.v_height) {
+		return;
+	}
+	for (unsigned int y = y0; y < y0 + h && y < vinfo.v_height; y++) {
+		uint32_t *row = (uint32_t *)(base + (unsigned long)y * vinfo.v_rowbytes);
+		for (unsigned int x = x0; x < x0 + w && x < vinfo.v_width; x++) {
+			row[x] = 0x00ffffffu;
+		}
+	}
+}
+
+/*
+ * u143: a number that cannot be scrolled away.
+ *
+ * The (since removed) USB driver published its state as a log line, but once the boot reaches launchd
+ * that line is pushed off the panel within seconds - four photo rounds in a row captured the
+ * tail of userspace and never the one number we needed.  So the same state is painted directly
+ * into the framebuffer as two two-digit values, "stage . last", with 3x5 dot-matrix glyphs.
+ *
+ * Text output is told to skip this rectangle (see muyu_vc_char_protected), and every scroll
+ * repaints it, so the readout survives both scrolling and a console spewing at full speed.
+ * The framebuffer is the only channel that has never lied on this port.
+ */
+static const unsigned char muyu_vc_glyph[10][5] = {
+	{ 0x7, 0x5, 0x5, 0x5, 0x7 },    /* 0 */
+	{ 0x2, 0x6, 0x2, 0x2, 0x7 },    /* 1 */
+	{ 0x7, 0x1, 0x7, 0x4, 0x7 },    /* 2 */
+	{ 0x7, 0x1, 0x7, 0x1, 0x7 },    /* 3 */
+	{ 0x5, 0x5, 0x7, 0x1, 0x1 },    /* 4 */
+	{ 0x7, 0x4, 0x7, 0x1, 0x7 },    /* 5 */
+	{ 0x7, 0x4, 0x7, 0x5, 0x7 },    /* 6 */
+	{ 0x7, 0x1, 0x1, 0x1, 0x1 },    /* 7 */
+	{ 0x7, 0x5, 0x7, 0x5, 0x7 },    /* 8 */
+	{ 0x7, 0x5, 0x7, 0x1, 0x7 },    /* 9 */
+};
+
+/* u148: set once the log dump owns the panel; from then on no console output and no scroll
+ * is allowed to touch the framebuffer. */
+static int muyu_vc_frozen;
+static unsigned int muyu_vc_st_x0, muyu_vc_st_y0;
+static unsigned int muyu_vc_st_x1, muyu_vc_st_y1;
+
+static void
+muyu_vc_glyph_paint(unsigned long base, unsigned int x0, unsigned int y0,
+    unsigned int px, unsigned int d)
+{
+	if (d > 9) {
+		d = 9;
+	}
+	for (unsigned int r = 0; r < 5; r++) {
+		for (unsigned int c = 0; c < 3; c++) {
+			if (muyu_vc_glyph[d][r] & (4u >> c)) {
+				muyu_vc_block(base, x0 + c * px, y0 + r * px,
+				    px - 2, px - 2);
+			}
+		}
+	}
+}
+
+static void
+muyu_vc_status_paint(void)
+{
+	extern int muyu_usb_stage_value(void) __attribute__((weak));
+	extern int muyu_usb_last_id(void) __attribute__((weak));
+	extern int muyu_usb_ring_code(void) __attribute__((weak));
+	unsigned long base = vinfo.v_baseaddr;
+	unsigned int px, gw, gap, x, y, cx, d[6];
+	int st, lid, rc;
+
+	if (muyu_vc_frozen) {
+		return;
+	}
+	if (base == 0 || vinfo.v_rowbytes == 0 || vinfo.v_depth != 32 ||
+	    vinfo.v_width < 320 || vinfo.v_height < 200) {
+		return;
+	}
+	if (muyu_usb_stage_value == 0 || muyu_usb_last_id == 0) {
+		return;
+	}
+	st = muyu_usb_stage_value();
+	lid = muyu_usb_last_id();
+	/* u146: a third pair.  "ring address rejected" was the one reading that sent two rounds
+	 * chasing low memory, and it was taken on a core whose soft reset had never been waited
+	 * out.  This pair makes the ring verdict a number on the panel instead of a sentence in a
+	 * log line that scrolls away: rc = HI_word_kept * 2 + (reset finished). */
+	rc = muyu_usb_ring_code ? muyu_usb_ring_code() : 0;
+
+	px = vinfo.v_width / 140;
+	if (px < 6) {
+		px = 6;
+	}
+	if (px > 20) {
+		px = 20;
+	}
+	gw = 3 * px;
+	gap = px + 2;
+
+	x = vinfo.v_width - (6 * gw + 11 * gap) - 24;
+	y = vinfo.v_height - 5 * px - 56;
+
+	muyu_vc_st_x0 = x - 6;
+	muyu_vc_st_y0 = y - 6;
+	muyu_vc_st_x1 = vinfo.v_width - 6;
+	muyu_vc_st_y1 = y + 5 * px + 6;
+
+	/* negative or out-of-range shows as 88, which no real stage ever reaches */
+	d[0] = (st < 0 || st > 99) ? 8u : (unsigned int)st / 10u;
+	d[1] = (st < 0 || st > 99) ? 8u : (unsigned int)st % 10u;
+	d[2] = (lid < 0 || lid > 99) ? 8u : (unsigned int)lid / 10u;
+	d[3] = (lid < 0 || lid > 99) ? 8u : (unsigned int)lid % 10u;
+	d[4] = (rc < 0 || rc > 99) ? 8u : (unsigned int)rc / 10u;
+	d[5] = (rc < 0 || rc > 99) ? 8u : (unsigned int)rc % 10u;
+
+	cx = x;
+	for (int i = 0; i < 6; i++) {
+		if (i == 2 || i == 4) {
+			/* separator: keeps "13 05 17" from reading as one long number */
+			muyu_vc_block(base, cx, y + 2 * px, gap - 2, gap - 2);
+			cx += gap + gap;
+		}
+		muyu_vc_glyph_paint(base, cx, y, px, d[i]);
+		cx += gw + gap;
+	}
+}
+
+/*
+ * u146: the heartbeat repaints this every 15 s, which is useless if the boot stops before the
+ * first tick - and u144/u145 both stopped inside the driver.  The driver calls this once when it
+ * is done, so the numbers are on the panel whatever happens next.
+ */
+void
+muyu_vc_status_repaint(void)
+{
+	muyu_vc_status_paint();
+}
+
+/*
+ * u148: a full-panel log dump.
+ *
+ * The panel has been the only trustworthy channel on this port, and its limit is not the
+ * framebuffer - it is the console's 28 lines of 8x16 cells.  The kernel already keeps the last
+ * 128 KiB of *everything* (BSD printf, PE kprintf, and userspace output that reaches the
+ * console) in muyu_debug's ring, so the missing piece was only a way to show more of it at once.
+ *
+ * The cells here are 8x8: each glyph row is two rows of the built-in 8x16 face OR-ed together,
+ * which keeps the shapes recognisable and doubles the line count.  At this port's console
+ * geometry that is about 100 columns by 56 rows - twice the console, on one photo.
+ *
+ * Once drawn, the panel is frozen: vc_paint_char, both scroll directions, the heartbeat bar and
+ * the status digits all bail out, so nothing scrolls the dump away or overdraws it.
+ */
+static char muyu_vc_dump[8192];
+
+static void
+muyu_vc_dump_glyph(unsigned long base, unsigned int x, unsigned int y, unsigned char ch)
+{
+	const unsigned char *g = iso_font + (ch * ISO_CHAR_HEIGHT);
+
+	if (x + 8 > vinfo.v_width || y + 8 > vinfo.v_height) {
+		return;
+	}
+	for (unsigned int r = 0; r < 8; r++) {
+		unsigned int bits = (unsigned int)g[2 * r] | (unsigned int)g[2 * r + 1];
+		uint32_t *row = (uint32_t *)(base + (y + r) * vinfo.v_rowbytes) + x;
+
+		if (bits == 0) {
+			continue;
+		}
+		for (unsigned int c = 0; c < 8; c++) {
+			if (bits & (0x80u >> c)) {
+				row[c] = 0x00ffffffu;
+			}
+		}
+	}
+}
+
+int
+muyu_vc_logdump(void)
+{
+	extern unsigned muyu_debug_copy(uint64_t *, char *, unsigned) __attribute__((weak));
+	extern uint64_t muyu_debug_total(void) __attribute__((weak));
+	unsigned long base = vinfo.v_baseaddr;
+	unsigned int cols, rows, want, n, i, cx, cy, y;
+	uint64_t total, start;
+
+	if (base == 0 || vinfo.v_depth != 32 || vinfo.v_rowbytes == 0 ||
+	    vinfo.v_width < 256 || vinfo.v_height < 64) {
+		return 0;
+	}
+	if (muyu_debug_copy == 0 || muyu_debug_total == 0) {
+		return 0;
+	}
+	cols = vinfo.v_width / 8;
+	rows = vinfo.v_height / 8;
+	while (rows > 8 && (uint64_t)cols * rows > sizeof(muyu_vc_dump)) {
+		rows--;
+	}
+	if (cols < 32 || rows < 8) {
+		return 0;
+	}
+	want = cols * rows;
+	total = muyu_debug_total();
+	start = (total > want) ? (total - want) : 0;
+	n = muyu_debug_copy(&start, muyu_vc_dump, want);
+	if (n == 0) {
+		/* The mirror is held by whoever is printing right now; try again next tick rather than
+		 * blanking the panel and freezing an empty screen. */
+		return 0;
+	}
+	for (y = 0; y < vinfo.v_height; y++) {
+		memset((void *)(base + y * vinfo.v_rowbytes), 0, vinfo.v_rowbytes);
+	}
+	cx = 0;
+	cy = 0;
+	for (i = 0; i < n; i++) {
+		unsigned char ch = (unsigned char)muyu_vc_dump[i];
+
+		if (ch == '\r') {
+			continue;
+		}
+		if (ch == '\n') {
+			cx = 0;
+			if (++cy >= rows) {
+				break;
+			}
+			continue;
+		}
+		if (ch < 32 || ch > 126) {
+			ch = '.';
+		}
+		if (cx >= cols) {
+			cx = 0;
+			if (++cy >= rows) {
+				break;
+			}
+		}
+		muyu_vc_dump_glyph(base, cx * 8, cy * 8, ch);
+		cx++;
+	}
+	muyu_vc_frozen = 1;
+	return (int)n;
+}
+
+/*
+ * u156: paint a caller-supplied text buffer, same 8x8 cell dump as muyu_vc_logdump().
+ *
+ * Why this exists: the panel is the only channel that has never failed on this port, but until now
+ * it could only show this kernel's own console mirror.  The Linux reader writes its kernel log to
+ * pstore, which lives at a fixed physical address (ramoops at 0xa7000000, console zone 2 MiB), so
+ * reading that window and painting it here turns the panel into a reader for the *other* kernel's
+ * log - no USB, no storage and no working driver required on the Linux side.
+ *
+ * The tail is painted, not the head: a kernel log is only interesting where it stops.
+ */
+int
+muyu_vc_textdump(const char *buf, unsigned len)
+{
+	unsigned long base = vinfo.v_baseaddr;
+	unsigned int cols, rows, want, n, i, cx, cy, y;
+
+	if (base == 0 || vinfo.v_depth != 32 || vinfo.v_rowbytes == 0 ||
+	    vinfo.v_width < 256 || vinfo.v_height < 64) {
+		return 0;
+	}
+	cols = vinfo.v_width / 8;
+	rows = vinfo.v_height / 8;
+	while (rows > 8 && (uint64_t)cols * rows > sizeof(muyu_vc_dump)) {
+		rows--;
+	}
+	if (cols < 32 || rows < 8 || len == 0) {
+		return 0;
+	}
+	want = cols * rows;
+	if (len > want) {
+		buf += len - want;
+		len = want;
+	}
+	n = len;
+	for (y = 0; y < vinfo.v_height; y++) {
+		memset((void *)(base + y * vinfo.v_rowbytes), 0, vinfo.v_rowbytes);
+	}
+	cx = 0;
+	cy = 0;
+	for (i = 0; i < n; i++) {
+		unsigned char ch = (unsigned char)buf[i];
+
+		if (ch == '\r') {
+			continue;
+		}
+		if (ch == '\n') {
+			cx = 0;
+			if (++cy >= rows) {
+				break;
+			}
+			continue;
+		}
+		if (ch < 32 || ch > 126) {
+			ch = '.';
+		}
+		if (cx >= cols) {
+			cx = 0;
+			if (++cy >= rows) {
+				break;
+			}
+		}
+		muyu_vc_dump_glyph(base, cx * 8, cy * 8, ch);
+		cx++;
+	}
+	muyu_vc_frozen = 1;
+	return (int)n;
+}
+
+/*
+ * u159: the same diagnosis as u157's page, but large enough that a phone photograph is enough.
+ *
+ * u157 packed these values into the 8x8 textdump grid, which is tuned for context - 56 lines on
+ * one panel - and therefore minimises legibility.  That is the wrong trade for a channel whose
+ * only reader is a camera: fifty-six unreadable lines are worth less than three readable numbers.
+ * The next step depends on four values, so they get the whole screen.
+ *
+ *   row 1   magic, eight hex digits    46554e4b = 'FUNK', so a real panic header survived
+ *   row 2   src | log KiB | ss KiB     src 1 = the pram node is live, 0 = fell back to kernel RAM
+ *   row 3   kept KiB | build 159       the build number keeps an old photo from being mistaken
+ *
+ * Each glyph is a 3x5 bitmap of solid blocks.  At 3200 px wide a cell is 57 px and a digit is
+ * 171x285, which survives a hand-held shot from half a metre away.
+ */
+static const unsigned char muyu_big_font[16][5] = {
+	{ 7, 5, 5, 5, 7 }, { 2, 6, 2, 2, 7 }, { 7, 1, 7, 4, 7 }, { 7, 1, 7, 1, 7 },
+	{ 5, 5, 7, 1, 1 }, { 7, 4, 7, 1, 7 }, { 7, 4, 7, 5, 7 }, { 7, 1, 1, 1, 1 },
+	{ 7, 5, 7, 5, 7 }, { 7, 5, 7, 1, 7 }, { 7, 5, 7, 5, 5 }, { 6, 5, 6, 5, 6 },
+	{ 7, 4, 4, 4, 7 }, { 6, 5, 5, 5, 6 }, { 7, 4, 7, 4, 7 }, { 7, 4, 7, 4, 4 },
+};
+
+static void
+muyu_vc_bigchar(unsigned long base, unsigned int x, unsigned int y,
+    unsigned int cell, unsigned int v)
+{
+	const unsigned char *g = muyu_big_font[v & 0xf];
+	/* one cell of gap between dots, or the five rows merge into a bar once photographed */
+	unsigned int dot = cell - (cell >> 3);
+
+	for (unsigned int r = 0; r < 5; r++) {
+		for (unsigned int c = 0; c < 3; c++) {
+			if (g[r] & (4u >> c)) {
+				muyu_vc_block(base, x + c * cell, y + r * cell, dot, dot);
+			}
+		}
+	}
+}
+
+static void
+muyu_vc_bigrow(unsigned long base, unsigned int y, unsigned int cell,
+    const unsigned char *v, unsigned int n)
+{
+	unsigned int step = cell * 4;           /* three cells of glyph plus one cell of gap */
+	unsigned int wide = (n - 1) * step + cell * 3;
+	unsigned int x = (vinfo.v_width - wide) / 2;
+
+	for (unsigned int i = 0; i < n; i++) {
+		muyu_vc_bigchar(base, x + i * step, y, cell, v[i]);
+	}
+}
+
+int
+muyu_vc_pram_bigpage(void)
+{
+	extern uint64_t muyu_pram_info[9] __attribute__((weak));
+	unsigned long base = vinfo.v_baseaddr;
+	unsigned char row[8];
+	unsigned int cell, y0, i;
+	uint64_t magic, src, loglen, sslen, kept;
+
+	if (muyu_vc_frozen || base == 0 || vinfo.v_depth != 32 ||
+	    vinfo.v_rowbytes == 0 || vinfo.v_width < 800 || vinfo.v_height < 600) {
+		return 0;
+	}
+	if (muyu_pram_info == 0) {
+		return 0;
+	}
+	magic = muyu_pram_info[3];
+	src = muyu_pram_info[2];
+	loglen = muyu_pram_info[5] / 1024;
+	sslen = muyu_pram_info[7] / 1024;
+	kept = muyu_pram_info[8] / 1024;
+
+	/* Black first.  The console underneath is still full of boot text, and white blocks on top of
+	 * 8x16 glyphs is unreadable; wiping 27 MiB costs far less than one wasted photograph. */
+	for (unsigned int y = 0; y < vinfo.v_height; y++) {
+		uint32_t *r = (uint32_t *)(base + (unsigned long)y * vinfo.v_rowbytes);
+
+		for (unsigned int x = 0; x < vinfo.v_width; x++) {
+			r[x] = 0;
+		}
+	}
+
+	cell = vinfo.v_width / 56;
+	if (cell < 24) {
+		cell = 24;
+	}
+	if (cell > 96) {
+		cell = 96;
+	}
+	/* three rows of five cells, two gaps of two cells: nineteen cells tall, centred */
+	y0 = (vinfo.v_height - cell * 19) / 2;
+
+	for (i = 0; i < 8; i++) {
+		row[i] = (unsigned char)((magic >> (28 - 4 * i)) & 0xf);
+	}
+	muyu_vc_bigrow(base, y0, cell, row, 8);
+
+	row[0] = (unsigned char)src;
+	for (i = 0; i < 3; i++) {
+		unsigned int div = (i == 0) ? 100 : (i == 1) ? 10 : 1;
+
+		row[1 + i] = (unsigned char)((loglen / div) % 10);
+		row[4 + i] = (unsigned char)((sslen / div) % 10);
+	}
+	muyu_vc_bigrow(base, y0 + cell * 7, cell, row, 7);
+
+	for (i = 0; i < 3; i++) {
+		unsigned int div = (i == 0) ? 100 : (i == 1) ? 10 : 1;
+
+		row[i] = (unsigned char)((kept / div) % 10);
+	}
+	row[3] = 1;
+	row[4] = 5;
+	row[5] = 9;
+	muyu_vc_bigrow(base, y0 + cell * 14, cell, row, 6);
+
+	muyu_vc_frozen = 1;
+	return 1;
+}
+
+static int
+muyu_vc_char_protected(unsigned int xx, unsigned int yy)
+{
+	unsigned int px0, py0, px1, py1;
+
+	if (muyu_vc_st_x1 == 0) {
+		return 0;
+	}
+	px0 = xx * ISO_CHAR_WIDTH;
+	py0 = yy * ISO_CHAR_HEIGHT;
+	px1 = px0 + ISO_CHAR_WIDTH;
+	py1 = py0 + ISO_CHAR_HEIGHT;
+
+	return !(px1 <= muyu_vc_st_x0 || px0 >= muyu_vc_st_x1 ||
+	    py1 <= muyu_vc_st_y0 || py0 >= muyu_vc_st_y1);
+}
+
+void
+muyu_vc_bar(unsigned int n)
+{
+	unsigned long base = vinfo.v_baseaddr;
+
+	if (muyu_vc_frozen) {
+		return;
+	}
+
+	if (base == 0 || vinfo.v_rowbytes == 0 || vinfo.v_depth != 32 ||
+	    vinfo.v_width < 128 || vinfo.v_height < 64) {
+		return;
+	}
+	muyu_vc_status_paint();
+	if (n > 40) {
+		n = 40;
+	}
+	for (unsigned int i = 0; i < n; i++) {
+		/* copy A: bottom edge, growing right */
+		muyu_vc_block(base, 8 + i * 20, vinfo.v_height - 28, 14, 20);
+		/* copy B: right edge, growing down from half the nominal height */
+		muyu_vc_block(base, vinfo.v_width - 40, vinfo.v_height / 2 + i * 20, 14, 14);
+	}
+}
