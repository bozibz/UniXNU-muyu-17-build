@@ -168,6 +169,41 @@ MACRO_BEGIN                                             \
 	lck_ticket_unlock(&vcputc_lock);                    \
 MACRO_END
 
+/*
+ * u127: the console must not be able to kill the machine.
+ *
+ * vcputc_options() took vcputc_lock with lck_ticket_lock(), which disables preemption and spins
+ * until the holder releases.  If the holder never does - a thread killed mid-print, or an
+ * interrupt that re-entered the console while the interrupted thread held the lock - the spinner
+ * parks with preemption disabled and, on this port (sheng-smp=0), that is the only CPU: no
+ * timers, no heartbeat, no panic, and a screen frozen exactly where the last character landed.
+ * That is the u126 signature: launchd/earlyboot output right up to "cache sent to launchd
+ * successfully" and then nothing at all, not even the 15 s heartbeat.
+ *
+ * So take the lock on a budget.  When the budget runs out the character is dropped and counted
+ * instead of waiting forever; losing console text is always better than losing the machine.
+ */
+#define MUYU_VC_LOCK_SPINS 200000u
+unsigned int muyu_vc_lock_giveup;
+
+unsigned int
+muyu_vc_lock_giveups(void)
+{
+	return muyu_vc_lock_giveup;
+}
+
+static boolean_t
+muyu_vc_trylock(void)
+{
+	for (unsigned int i = 0; i < MUYU_VC_LOCK_SPINS; i++) {
+		if (lck_ticket_lock_try(&vcputc_lock, &vconsole_lck_grp)) {
+			return TRUE;
+		}
+	}
+	muyu_vc_lock_giveup++;
+	return FALSE;
+}
+
 
 /*
  # Attribute codes:
@@ -1230,8 +1266,13 @@ gc_update_color(int color, boolean_t fore)
 void
 vcputc_options(char c, __unused bool poll)
 {
+	if (boot_progress_active()) { boot_progress_putc(c); return; }
 	if (gc_initialized && gc_enabled) {
-		VCPUTC_LOCK_LOCK();
+		/* u127: bounded wait - see muyu_vc_trylock(). A wedged holder costs a character,
+		 * no longer the whole machine. */
+		if (!muyu_vc_trylock()) {
