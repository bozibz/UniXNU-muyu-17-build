+		uint32_t length = panic_info->eph_panic_log_len;
+		if ((offset >= sizeof(*panic_info)) && (offset < gPanicSize) && (length != 0) &&
+		    (length <= gPanicSize - offset)) {
+			size_t copy = length < (sizeof(last_panic_text) - 1) ? length : (sizeof(last_panic_text) - 1);
+			memcpy(last_panic_text, (const void *)(gPanicBase + offset + length - copy), copy);
+			last_panic_text[copy] = '\0';
+			last_panic_text_len = (uint32_t)copy;
+			last_panic_text_valid = TRUE;
+		}
+	}
