 		panic_console_available = TRUE;
@@ -197,6 +216,44 @@
 	bzero((void *)gPanicBase, gPanicSize);
 }
 
+void
+pe_print_last_panic(void)
+{
+	/* The pram ring is only partly written, so the captured block carries NUL holes.
+	 * They are line breaks, not the end of the text: print the whole block so one
+	 * screenshot shows the tail of the previous boot. */
+	if (last_panic_text_valid) {
+		for (uint32_t at = 0; at < last_panic_text_len; at++) {
+			if (last_panic_text[at] == '\0') {
+				last_panic_text[at] = '\n';
+			}
+		}
+	}
+	printf("PREVIOUS XNU LOG (pram=%p size=%u valid=%d bytes=%u):\n%s\n",
+	    (void *)gPanicBase, gPanicSize, last_panic_text_valid ? 1 : 0,
+	    (unsigned int)last_panic_text_len,
+	    last_panic_text_valid ? last_panic_text : "(no previous log captured)");
+	last_panic_text_valid = FALSE;
+}
+
+/* Callable from the critical-exit path, where the panic screen is mapped and can draw. */
+void
+pe_panic_last_log(void)
+{
+	unsigned int render = 0;
+	if (!PE_parse_boot_argn("-muyu-last-log-panic", &render, sizeof(render)) || !render) {
+		return;
+	}
+	const uint32_t tail = 3500;
+	const char *from = last_panic_text + (last_panic_text_len > tail ? last_panic_text_len - tail : 0);
+	uint32_t magic = 0;
+	if (gPanicBase && gPanicSize >= sizeof(struct embedded_panic_header)) {
+		magic = ((const struct embedded_panic_header *)(uintptr_t)gPanicBase)->eph_magic;
+	}
+	panic("LASTLOG pram=%p size=%u magic=%x bytes=%u tail:\n%s",
+	    (void *)gPanicBase, gPanicSize, magic, last_panic_text_len, from);
+}
