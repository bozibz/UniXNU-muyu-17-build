#!/bin/busybox sh
# muyu log reader (v3, 2026-11-08 15:20).
#
# Runs as /init from the init_boot ramdisk, which is the ramdisk this ABL actually hands to the
# kernel (boot.img carries none: ramdisk_size = 0, and the bootloader ignores a boot-image ramdisk
# anyway).  The vendor's 347 modules arrive from vendor_boot's vendor ramdisk, concatenated after
# this one, so /lib/modules is populated while /init is ours.
#
# Observations that shape this file, all measured on this tablet today:
#   - CONFIG_DEVTMPFS is not set  -> /dev must be created with mknod, there is no devtmpfs to mount
#   - CONFIG_VT is not set        -> no tty0, no fbcon: the panel cannot show anything from Linux
#   - CONFIG_DEVMEM is not set    -> no /dev/mem, so no poking the splash framebuffer either
#   - CONFIG_PSTORE_CONSOLE is set-> printk lands in ramoops at 0xa7000000, which the XNU payload
#                                    can read and paint.  That is the only usable output channel.
#
# So this script logs everything to /dev/kmsg (=> pstore), tries hard to bring up the UDC, and when
# it fails it hands the device back to the bootloader *by reboot reason* rather than sitting dark:
# a warm reboot keeps the ramoops contents, a power cycle destroys them.

/bin/busybox --install -s /bin 2>/dev/null
export PATH=/bin:/sbin
mkdir -p /proc /sys /dev /run /tmp /sys/kernel/config 2>/dev/null
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sys /sys 2>/dev/null
mount -t configfs configfs /sys/kernel/config 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null

# --- /dev by hand (no devtmpfs in this kernel) ---------------------------------------------------
[ -c /dev/console ] || mknod /dev/console c 5 1 2>/dev/null
[ -c /dev/null ] || mknod /dev/null c 1 3 2>/dev/null
[ -c /dev/zero ] || mknod /dev/zero c 1 5 2>/dev/null
[ -c /dev/tty ] || mknod /dev/tty c 5 0 2>/dev/null
[ -c /dev/kmsg ] || mknod /dev/kmsg c 1 11 2>/dev/null

L=/run/reader.log
: >$L
say() {
    echo "$*" >>$L
    echo "muyu-reader: $*" >/dev/kmsg 2>/dev/null
    return 0
}

# 2026-11-08 15:26: the previous run hung inside an insmod and never reached the fallback at the
# bottom of this file, so the tablet sat dark with the log unreachable.  A driver probe can block
# for minutes (pmic_glink/ucsi wait on transports that Android userspace normally brings up), and no
# amount of ordering inside one script survives that.  So the deadline is armed first, in its own
# process, and it only stands down if the shell actually came up.  A reboot by reason keeps the
# ramoops contents; a power cycle does not.
( sleep 60
  [ -e /run/serve ] && exit 0
  echo "muyu-reader: watchdog fired, rebooting to bootloader" >/dev/kmsg 2>/dev/null
  sync
  exec /bin/rb bootloader ) &

# populate /dev from sysfs: works for both char and block, whatever the majors turn out to be
mkdevs() {
    for f in /sys/class/block/*/dev /sys/class/tty/*/dev; do
        [ -e "$f" ] || continue
        n=$(basename "$(dirname "$f")")
        v=$(cat "$f" 2>/dev/null)
        [ -n "$v" ] || continue
        case "$n" in
            console|null|zero|tty|kmsg) continue ;;
        esac
        if [ -e "/sys/class/block/$n" ]; then t=b; else t=c; fi
        [ -e "/dev/$n" ] || mknod "/dev/$n" $t "${v%:*}" "${v#*:}" 2>/dev/null
    done
}

say "muyu log reader $(uname -r) $(uname -m)"

# --- modules -------------------------------------------------------------------------------------
# The vendor's own order, verbatim: modules.load is dependency ordered, because Android's first
# stage insmods it exactly this way.
n=0; f=0
for m in $(cat /lib/modules/modules.load 2>/dev/null); do
    [ -f /lib/modules/$m ] || continue
    if insmod /lib/modules/$m 2>>$L; then n=$((n + 1)); else f=$((f + 1)); fi
done
say "modules: ok=$n failed=$f"

# The storage and USB device stacks are not in modules.load (Android loads them on demand), so they
# are listed here in dependency order, computed from the vendor's own modules.dep.
for m in qmi_helpers qcom_smd qcom_glink qcom_glink_smem rproc_qcom_common pdr_interface \
         pmic_glink ucsi_glink wcd_usbss_i2c repeater redriver \
         dwc3-msm phy-msm-snps-eusb2 repeater-qti-pmic-eusb2; do
    say "insmod $m ..."
    insmod /lib/modules/$m.ko 2>>$L && say "insmod $m ok" || say "insmod $m failed"
done
mkdevs
say "udc=[$(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')] scsi=[$(ls /sys/class/scsi_host 2>/dev/null | tr '\n' ' ')]"

# --- usb gadget ----------------------------------------------------------------------------------
for r in /sys/class/usb_role/*/role; do [ -e "$r" ] && echo device >"$r" 2>/dev/null; done
G=/sys/kernel/config/usb_gadget/log
mkdir -p $G/strings/0x409 $G/configs/c.1 $G/functions/acm.usb0 2>/dev/null
if [ -d "$G" ]; then
    echo 0x1d6b >$G/idVendor 2>/dev/null
    echo 0x0104 >$G/idProduct 2>/dev/null
    echo 0x0100 >$G/bcdDevice 2>/dev/null
    echo 0x0200 >$G/bcdUSB 2>/dev/null
    echo muyulog >$G/strings/0x409/serialnumber 2>/dev/null
    echo muyu-log-reader >$G/strings/0x409/product 2>/dev/null
    echo muyu >$G/strings/0x409/manufacturer 2>/dev/null
    ln -sf $G/functions/acm.usb0 $G/configs/c.1/ 2>/dev/null
    U=
    for i in $(seq 1 12); do
        U=$(ls /sys/class/udc 2>/dev/null | head -n1)
        [ -n "$U" ] && break
        for r in /sys/class/usb_role/*/role; do [ -e "$r" ] && echo device >"$r" 2>/dev/null; done
        sleep 1
    done
    if [ -n "$U" ]; then
        echo "$U" >$G/UDC 2>/dev/null && say "usb: acm bound to $U" || say "usb: bind to $U failed"
    else
        say "usb: no udc"
    fi
else
    say "usb: no configfs gadget directory"
fi
mkdevs
say "ttyGS=[$(ls /dev/ttyGS* 2>/dev/null | tr '\n' ' ')]"

# --- log window ----------------------------------------------------------------------------------
# Dropped in v4: it read 32 MiB off userdata over UFS, which is the slowest and least likely step in
# this script, and the pstore channel now carries what that window was for.

# --- either serve the shell, or hand back to the bootloader --------------------------------------
if [ -e /dev/ttyGS0 ]; then
    : >/run/serve
    say "ready: shell on USB serial"
    while true; do
        setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'
        sleep 1
    done
fi

say "no udc: rebooting to bootloader so the ramoops log survives (power cycle would lose it)"
dmesg 2>/dev/null | tail -n 400 >/dev/kmsg 2>/dev/null
sync
exec /bin/rb bootloader
